# glances-rs on distroless (multi-stage).
#
# Builder compiles from source on Debian 12 so the binary targets
# glibc <= 2.36 — the runtime's glibc. (A Fedora-built binary wants
# newer glibc and refuses to start here.) Pure-std, zero crates:
# rustup plus the pinned toolchain is the whole build closure.
# Runtime is Google distroless cc: glibc + libgcc + loader and
# nothing else — no shell, no package manager, no tools. NVIDIA,
# Intel, and AMD GPUs all work (nvidia-smi runs against the shipped
# loader; DRM GPUs are plain sysfs reads).
#
# Build from the repo root (context must be the root: the build
# copies Cargo.toml/src/assets; the ignore file stays at the root
# because podman only reads .containerignore from the context dir).
# --format docker is required: OCI output silently drops HEALTHCHECK,
# and Unraid runs real Docker anyway:
#   podman build --format docker -t glances-rs:latest -f install/docker/Containerfile .
#
# Run against the HOST (a monitor in a bare container only sees
# itself). /host + GLANCES_ROOTFS give the fs plugin the host mount
# table instead of overlay + CDI binds. Add -e GLANCES_API_KEY=<secret>
# to gate the dashboard data + API behind an X-API-Key header, and
# -e GLANCES_KWH_RATE=<dollars> (e.g. 0.08) to enable the monthly
# power-cost figure:
#   podman run -d --name glances-rs --pid=host --net=host \
#     -v /sys:/sys:ro -v /:/host:ro -e GLANCES_ROOTFS=/host \
#     glances-rs:latest -w
#
# NVIDIA live stats need passthrough (CDI devices + the host's
# nvidia-smi binary; the image deliberately ships neither):
#   podman run -d --name glances-rs --pid=host --net=host \
#     -v /sys:/sys:ro -v /:/host:ro -e GLANCES_ROOTFS=/host \
#     --device nvidia.com/gpu=all \
#     -v /usr/bin/nvidia-smi:/usr/bin/nvidia-smi:ro \
#     glances-rs:latest -w
ARG DEBIAN_VERSION=12

FROM docker.io/library/debian:${DEBIAN_VERSION}-slim AS builder
RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates curl gcc libc6-dev \
    && rm -rf /var/lib/apt/lists/*
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
      | sh -s -- -y --profile minimal --default-toolchain none
ENV PATH="/root/.cargo/bin:${PATH}"
WORKDIR /src
COPY . .
# The cargo proxy auto-installs the pinned toolchain from
# rust-toolchain.toml on first run; the build itself is offline
# (zero dependencies — nothing to download).
RUN cargo --version && cargo build --release --offline \
    && cp target/release/glances-rs /glances-rs

FROM gcr.io/distroless/cc-debian${DEBIAN_VERSION}
COPY --from=builder /glances-rs /usr/local/bin/glances-rs
LABEL org.opencontainers.image.title="glances-rs" \
      org.opencontainers.image.description="Lightweight Linux system monitor: dashboard + REST API in one static binary" \
      org.opencontainers.image.source="https://github.com/UberMetroid/glances-rs"
EXPOSE 61208
# Self-probe: the binary checks its own /api/4/health (no curl in
# distroless). Probes the DEFAULT port — if you run with a custom
# --web-port, override with --health-cmd.
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s \
  CMD ["/usr/local/bin/glances-rs", "--ping", "127.0.0.1:61208"]
ENTRYPOINT ["/usr/local/bin/glances-rs"]
CMD ["-w"]
