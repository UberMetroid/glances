{
  "openapi": "3.1.0",
  "info": {
    "title": "glances-rs REST API",
    "version": "0.10.53",
    "description": "System-monitor API served by `glances-rs -w` (default port 61208). Unversioned `/api/` aliases serve the same payloads as `/api/4/`. With `--auth-enabled`, every route requires HTTP Basic (401 otherwise) except `/favicon.ico`; with `GLANCES_API_KEY` set, `X-API-Key` passes instead (either passes when both are on). There is no JWT issuer. Human reference with examples: docs/api.md."
  },
  "servers": [
    { "url": "http://localhost:61208", "description": "Local -w server" }
  ],
  "tags": [
    { "name": "meta", "description": "Liveness, inventory, snapshots, history." },
    { "name": "plugins", "description": "Per-plugin stats, field catalogs, history." },
    { "name": "processes", "description": "Single-process lookup and extended stats." },
    { "name": "events", "description": "Alert clearing and the SSE stream." },
    { "name": "ops", "description": "Health and machine-readable docs." }
  ],
  "paths": {
    "/api/4/status": {
      "get": {
        "tags": ["meta"],
        "summary": "Liveness check",
        "responses": {
          "200": {
            "description": "Build version.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Status" }
              }
            }
          }
        }
      }
    },
    "/api/4/pluginslist": {
      "get": {
        "tags": ["meta"],
        "summary": "Registered plugin names",
        "responses": {
          "200": {
            "description": "Names in registration order (34 by default; irq needs --enable-plugin).",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/PluginList" }
              }
            }
          }
        }
      }
    },
    "/api/4/serverslist": {
      "get": {
        "tags": ["meta"],
        "summary": "Server list",
        "responses": {
          "200": {
            "description": "Always empty on a standalone server.",
            "content": {
              "application/json": {
                "schema": { "type": "array", "maxItems": 0 }
              }
            }
          }
        }
      }
    },
    "/api/4/all": {
      "get": {
        "tags": ["meta"],
        "summary": "Full snapshot",
        "responses": {
          "200": {
            "description": "Every plugin's current object in one dictionary.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Snapshot" }
              }
            }
          }
        }
      }
    },
    "/api/all/values": {
      "get": {
        "tags": ["meta"],
        "summary": "Full snapshot (alias)",
        "responses": {
          "200": {
            "description": "Alias of /api/4/all; what the dashboard polls.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Snapshot" }
              }
            }
          }
        }
      }
    },
    "/api/all/stats": {
      "get": {
        "tags": ["meta"],
        "summary": "Full snapshot (alias)",
        "responses": {
          "200": {
            "description": "Alias of /api/4/all.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Snapshot" }
              }
            }
          }
        }
      }
    },
    "/api/4/all/limits": {
      "get": {
        "tags": ["meta"],
        "summary": "Alert thresholds",
        "responses": {
          "200": {
            "description": "Thresholds keyed by plugin name.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Limits" }
              }
            }
          }
        }
      }
    },
    "/api/all/limits": {
      "get": {
        "tags": ["meta"],
        "summary": "Alert thresholds (alias)",
        "responses": {
          "200": {
            "description": "Alias of /api/4/all/limits.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Limits" }
              }
            }
          }
        }
      }
    },
    "/api/4/all/views": {
      "get": {
        "tags": ["meta"],
        "summary": "View metadata",
        "responses": {
          "200": {
            "description": "Per-plugin sort key, declared fields, and alert decorations.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Views" }
              }
            }
          }
        }
      }
    },
    "/api/all/views": {
      "get": {
        "tags": ["meta"],
        "summary": "View metadata (alias)",
        "responses": {
          "200": {
            "description": "Alias of /api/4/all/views.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Views" }
              }
            }
          }
        }
      }
    },
    "/api/all/description": {
      "get": {
        "tags": ["meta"],
        "summary": "View metadata (alias)",
        "responses": {
          "200": {
            "description": "Alias of /api/4/all/views.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Views" }
              }
            }
          }
        }
      }
    },
    "/api/4/history": {
      "get": {
        "tags": ["meta"],
        "summary": "Recorded history for every plugin",
        "responses": {
          "200": {
            "description": "Histories keyed by plugin, then field.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/HistoryMap" }
              }
            }
          }
        }
      }
    },
    "/api/4/health": {
      "get": {
        "tags": ["meta"],
        "summary": "Computed health rollup",
        "responses": {
          "200": {
            "description": "Worst-of status plus per-check details; non-ok checks first.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Health" }
              }
            }
          }
        }
      }
    },
    "/api/4/dashboard": {
      "get": {
        "tags": ["meta"],
        "summary": "Dashboard bundle: fast plugin payloads plus health",
        "responses": {
          "200": {
            "description": "One object per fast plugin plus the health rollup under 'health'.",
            "content": {
              "application/json": {
                "schema": { "type": "object" }
              }
            }
          }
        }
      }
    },
    "/api/4/{plugin}": {
      "get": {
        "tags": ["plugins"],
        "summary": "One plugin's current object",
        "parameters": [
          {
            "name": "plugin",
            "in": "path",
            "required": true,
            "schema": { "type": "string" },
            "example": "cpu",
            "description": "Any name from GET /api/4/pluginslist."
          }
        ],
        "responses": {
          "200": {
            "description": "The plugin's current stats object.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/PluginPayload" }
              }
            }
          },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/api/4/{plugin}/values": {
      "get": {
        "tags": ["plugins"],
        "summary": "One plugin's current object (explicit form)",
        "parameters": [
          {
            "name": "plugin",
            "in": "path",
            "required": true,
            "schema": { "type": "string" },
            "example": "cpu"
          }
        ],
        "responses": {
          "200": {
            "description": "Same payload as GET /api/4/{plugin}.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/PluginPayload" }
              }
            }
          },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/api/4/{plugin}/description": {
      "get": {
        "tags": ["plugins"],
        "summary": "Field catalog for a plugin",
        "parameters": [
          {
            "name": "plugin",
            "in": "path",
            "required": true,
            "schema": { "type": "string" },
            "example": "cpu"
          }
        ],
        "responses": {
          "200": {
            "description": "Field names and units.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/FieldCatalog" }
              }
            }
          },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/api/4/{plugin}/history": {
      "get": {
        "tags": ["plugins"],
        "summary": "Recorded history for a plugin",
        "parameters": [
          {
            "name": "plugin",
            "in": "path",
            "required": true,
            "schema": { "type": "string" },
            "example": "cpu"
          }
        ],
        "responses": {
          "200": {
            "description": "Per-field points, oldest first.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/PluginHistory" }
              }
            }
          },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/api/4/{plugin}/history/{n}": {
      "get": {
        "tags": ["plugins"],
        "summary": "Tail of a plugin's history",
        "parameters": [
          {
            "name": "plugin",
            "in": "path",
            "required": true,
            "schema": { "type": "string" },
            "example": "cpu"
          },
          {
            "name": "n",
            "in": "path",
            "required": true,
            "schema": { "type": "integer", "minimum": 0 },
            "example": 60,
            "description": "Keep the last n points per field (0 = all)."
          }
        ],
        "responses": {
          "200": {
            "description": "Per-field points, oldest first.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/PluginHistory" }
              }
            }
          },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/api/4/processes/{pid}": {
      "get": {
        "tags": ["processes"],
        "summary": "One process by pid",
        "parameters": [
          {
            "name": "pid",
            "in": "path",
            "required": true,
            "schema": { "type": "integer" },
            "example": 1
          }
        ],
        "responses": {
          "200": {
            "description": "The process object.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Process" }
              }
            }
          },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/api/4/processes/extended": {
      "get": {
        "tags": ["processes"],
        "summary": "Pinned extended-stats process",
        "responses": {
          "200": {
            "description": "The pinned process, or {} when none is pinned.",
            "content": {
              "application/json": {
                "schema": { "type": "object" }
              }
            }
          }
        }
      }
    },
    "/api/4/processes/extended/{pid}": {
      "post": {
        "tags": ["processes"],
        "summary": "Pin extended stats for one process",
        "parameters": [
          {
            "name": "pid",
            "in": "path",
            "required": true,
            "schema": { "type": "integer" },
            "example": 1,
            "description": "One pid pinned at a time; re-pin to switch."
          }
        ],
        "responses": {
          "200": {
            "description": "Pinned.",
            "content": {
              "application/json": {
                "schema": { "type": "boolean", "example": true }
              }
            }
          },
          "400": {
            "description": "Non-numeric pid."
          },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/api/4/processes/extended/disable": {
      "post": {
        "tags": ["processes"],
        "summary": "Unpin the extended-stats process",
        "responses": {
          "200": {
            "description": "Unpinned.",
            "content": {
              "application/json": {
                "schema": { "type": "boolean", "example": true }
              }
            }
          }
        }
      }
    },
    "/api/4/events/clear/all": {
      "post": {
        "tags": ["events"],
        "summary": "Drop all alerts",
        "responses": {
          "200": {
            "description": "Cleared.",
            "content": {
              "application/json": {
                "schema": { "type": "object", "maxProperties": 0 }
              }
            }
          }
        }
      }
    },
    "/api/4/events/clear/warning": {
      "post": {
        "tags": ["events"],
        "summary": "Drop warning alerts",
        "responses": {
          "200": {
            "description": "Cleared. No critical-only route exists; use /all.",
            "content": {
              "application/json": {
                "schema": { "type": "object", "maxProperties": 0 }
              }
            }
          }
        }
      }
    },
    "/api/4/events/stream": {
      "get": {
        "tags": ["events"],
        "summary": "Alert event stream",
        "responses": {
          "200": {
            "description": "Server-Sent Events; opens with a hello event.",
            "content": {
              "text/event-stream": {
                "schema": { "type": "string" },
                "example": "event: hello\ndata: {\"msg\":\"glances-rs\"}\nid: 1\n\n"
              }
            }
          }
        }
      }
    },
    "/api/4/token": {
      "post": {
        "tags": ["ops"],
        "summary": "JWT token exchange (unimplemented)",
        "responses": {
          "501": {
            "description": "No JWT issuer in pure-std builds; use HTTP Basic.",
            "content": {
              "text/plain": {
                "schema": { "type": "string" },
                "example": "JWT authentication is not available in this build (pure-std, no token issuer)."
              }
            }
          }
        }
      }
    },
    "/healthz": {
      "get": {
        "tags": ["ops"],
        "summary": "Ops health check",
        "responses": {
          "200": {
            "description": "Server is up.",
            "content": {
              "text/plain": {
                "schema": { "type": "string" },
                "example": "ok\n"
              }
            }
          }
        }
      }
    },
    "/openapi.json": {
      "get": {
        "tags": ["ops"],
        "summary": "This OpenAPI document",
        "responses": {
          "200": {
            "description": "The machine-readable API spec.",
            "content": {
              "application/json": {
                "schema": { "type": "object" }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Status": {
        "type": "object",
        "required": ["version"],
        "properties": {
          "version": { "type": "string", "example": "0.10.53" }
        }
      },
      "PluginList": {
        "type": "array",
        "items": { "type": "string" },
        "example": ["cpu", "percpu", "mem", "network", "gpu"]
      },
      "Snapshot": {
        "type": "object",
        "description": "Every plugin's current object keyed by plugin name.",
        "additionalProperties": true,
        "example": { "cpu": { "total": 3.97 }, "mem": { "percent": 42.1 } }
      },
      "Limits": {
        "type": "object",
        "description": "Alert thresholds keyed by plugin name.",
        "additionalProperties": true
      },
      "Views": {
        "type": "object",
        "description": "Per-plugin view metadata: sort key, declared fields, alert decorations.",
        "additionalProperties": true
      },
      "HistoryMap": {
        "type": "object",
        "description": "Recorded histories keyed by plugin, then field.",
        "additionalProperties": { "$ref": "#/components/schemas/PluginHistory" }
      },
      "PluginHistory": {
        "type": "object",
        "description": "Per-field [timestamp, value] points, oldest first.",
        "additionalProperties": {
          "type": "array",
          "items": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 }
        }
      },
      "FieldCatalog": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["name", "unit"],
          "properties": {
            "name": { "type": "string" },
            "unit": { "type": "string" }
          }
        }
      },
      "PluginPayload": {
        "type": "object",
        "description": "One plugin's current stats object. Keys vary by plugin and host; field names and units come from GET /api/4/{plugin}/description.",
        "additionalProperties": true,
        "example": { "total": 3.97, "user": 2.73, "system": 0.6, "idle": 95.91, "cpucore": 12.0 }
      },
      "Process": {
        "type": "object",
        "description": "One process entry. Selected keys below; hosts vary.",
        "properties": {
          "pid": { "type": "integer" },
          "name": { "type": "string" },
          "status": { "type": "string" },
          "username": { "type": "string" },
          "nice": { "type": "integer" },
          "cpu_percent": { "type": "number" },
          "cpu_num": { "type": "integer" },
          "memory_percent": { "type": "number" },
          "memory_info": { "type": "object" },
          "num_threads": { "type": "integer" },
          "cmdline": { "type": "array", "items": { "type": "string" } },
          "cpu_times": { "type": "object" },
          "gids": { "type": "object" },
          "io_counters": { "type": "object" },
          "key": { "type": "string" },
          "time_since_update": { "type": "number" }
        },
        "additionalProperties": true
      },
      "Health": {
        "type": "object",
        "required": ["status", "summary", "checks"],
        "properties": {
          "status": { "type": "string", "enum": ["ok", "warning", "critical"] },
          "summary": { "type": "string", "example": "ALL SYSTEMS NOMINAL" },
          "checks": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "status", "detail"],
              "properties": {
                "name": { "type": "string", "example": "fs:/" },
                "status": { "type": "string", "enum": ["ok", "warning", "critical"] },
                "detail": { "type": "string", "example": "46.4% used" }
              }
            }
          }
        }
      }
    },
    "responses": {
      "NotFound": {
        "description": "Unknown path, plugin name, or pid."
      },
      "Unauthorized": {
        "description": "Credential required: HTTP Basic (--auth-enabled) or X-API-Key (GLANCES_API_KEY).",
        "content": {
          "text/plain": {
            "schema": { "type": "string" }
          }
        }
      }
    },
    "securitySchemes": {
      "basicAuth": {
        "type": "http",
        "scheme": "basic",
        "description": "Required on every route except /favicon.ico when the server runs with --auth-enabled."
      },
      "apiKey": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key",
        "description": "Passes in place of HTTP Basic on every gated route when the server runs with GLANCES_API_KEY set."
      }
    }
  }
}
